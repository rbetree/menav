# Cloudflare Pages 生产环境变量示例。
# 在 Pages 项目 → Settings → Environment variables 中逐项添加；标注 Secret 的项用加密类型。
MENAV_BACKEND_URL=https://menav-backend.<account>.workers.dev
MENAV_BUILD_TOKEN=replace-with-long-random-build-token
CF_ACCESS_CLIENT_ID=replace-with-access-service-token-client-id
CF_ACCESS_CLIENT_SECRET=replace-with-access-service-token-client-secret
NODE_VERSION=24
