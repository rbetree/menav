// MeNav 形态二动态后台 — wrangler 配置
{
  "name": "menav-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // 快照定时聚合重建(定案 T-2=B):每 5 分钟触发 scheduled;仅 dirty 时才真正重建。
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "menav-backend",
      "database_id": "__PLACEHOLDER__" // 本地 wrangler dev 用 miniflare 无需真实 id;部署前 wrangler d1 create menav-backend 后替换
    }
  ],
  "vars": {
    "TEAM_DOMAIN": "", // Cloudflare Access team domain,如 https://<team>.cloudflareaccess.com（真实部署必配，鉴权强制）
    "POLICY_AUD": "", // Access 应用 AUD tag（真实部署必配，鉴权强制）
    "BUILD_HOOK_URL": "" // 快照构建执行体回调 URL（定案 T-1=A,部署侧）;为空则 rebuild 仅消费 dirty 不发外部构建
    // 注意:ALLOW_INSECURE_DEV 不入 vars(M9)——随部署产物携带会在线上误开「全站后台公开可写」;
    // 仅可在本地 .dev.vars(已 gitignore)设 '1' 放行本地开发/冒烟。
  },
  "observability": {
    "enabled": true
  }
}