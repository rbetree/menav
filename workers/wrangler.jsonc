// MeNav 形态二动态后台 — wrangler 配置
{
  "name": "menav-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": { "directory": "../admin", "binding": "ASSETS", "run_worker_first": true },
  // 每 5 分钟检查发布状态；仅有未发布内容版本时创建构建。
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "menav-test",
      "database_id": "81fdec81-8765-4a10-9263-8d435f858410", // 独立测试库 menav-test(uuid)；正式部署前再确认
      "remote": true, // wrangler dev 本地跑 worker、D1 连远端测试库
    },
  ],
  "vars": {
    "TEAM_DOMAIN": "https://rzlnb.cloudflareaccess.com", // Cloudflare Access team domain
    "POLICY_AUD": "ad393a62d5fb8e5f813aead98aa78d5caa2a28f5c6ca80a74ff83587052884bf", // Access 应用 AUD tag
    "CF_ACCOUNT_ID": "deaeb6843e567453c653af211554ee25", // Pages 所属 Cloudflare 账号
    "CF_PAGES_PROJECT": "menav-web-test", // 独立的动态公开站 Pages 项目
    // CF_API_TOKEN（Pages Write）和 BUILD_TOKEN 用 wrangler secret 设置。
    // ALLOW_INSECURE_DEV 仅在本地 .dev.vars（已 gitignore）设为 '1'，不写入部署配置。
  },
  "observability": {
    "enabled": true,
  },
}
