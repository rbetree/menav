// MeNav 形态二动态后台 — wrangler 配置
// 顶层为本地开发/默认;测试部署使用命名环境:`wrangler deploy --env staging`。
// 注意:vars / bindings / triggers 在命名环境间不可继承,每个 env 必须完整重写。
{
  "name": "menav-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": { "directory": "../admin", "binding": "ASSETS", "run_worker_first": true },
  // 每 5 分钟检查发布状态;仅有未发布内容版本或强制重建时创建构建。
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "menav-test",
      "database_id": "81fdec81-8765-4a10-9263-8d435f858410",
      // 本地 `wrangler dev` 让 Worker 跑在本地、D1 连远端库(会写真实数据,谨慎使用)。
      "remote": true,
    },
  ],
  "vars": {
    "TEAM_DOMAIN": "https://rzlnb.cloudflareaccess.com",
    "POLICY_AUD": "ad393a62d5fb8e5f813aead98aa78d5caa2a28f5c6ca80a74ff83587052884bf",
    "CF_ACCOUNT_ID": "deaeb6843e567453c653af211554ee25",
    "CF_PAGES_PROJECT": "menav-web-test",
    // CF_API_TOKEN(Pages 发布) 与 BUILD_TOKEN 用 wrangler secret 设置,不写在此处。
  },
  "observability": {
    "enabled": true,
  },

  "env": {
    "staging": {
      "name": "menav-backend-test",
      "assets": { "directory": "../admin", "binding": "ASSETS", "run_worker_first": true },
      "triggers": {
        "crons": ["*/5 * * * *"],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "menav-test",
          "database_id": "81fdec81-8765-4a10-9263-8d435f858410",
        },
      ],
      "vars": {
        "TEAM_DOMAIN": "https://rzlnb.cloudflareaccess.com",
        "POLICY_AUD": "ad393a62d5fb8e5f813aead98aa78d5caa2a28f5c6ca80a74ff83587052884bf",
        "CF_ACCOUNT_ID": "deaeb6843e567453c653af211554ee25",
        "CF_PAGES_PROJECT": "menav-web-test",
      },
      "observability": {
        "enabled": true,
      },
    },
  },
}
