// MeNav 形态二动态后台 — 测试环境 wrangler 配置示例
// 复制为 wrangler.test.jsonc 后填写测试资源；该文件不要提交。
// deploy:test / dev:test 使用 --env staging，只读取下面的 env.staging 段。
// 注意：vars / bindings 在命名环境间不可继承，env.staging 必须完整重写。
{
  "name": "menav-backend-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "env": {
    "staging": {
      "name": "menav-backend-staging",
      "assets": { "directory": "../admin", "binding": "ASSETS", "run_worker_first": true },
      "triggers": { "crons": [] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "menav-db-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_DATABASE_ID",
          // 测试环境默认连远端 D1；本地调试请改用 wrangler.local.jsonc。
          "remote": true,
        },
      ],
      "vars": {
        "TEAM_DOMAIN": "https://REPLACE_WITH_TEAM.cloudflareaccess.com",
        "POLICY_AUD": "REPLACE_WITH_STAGING_ACCESS_AUD",
        "CF_ACCOUNT_ID": "REPLACE_WITH_ACCOUNT_ID",
        "CF_PAGES_PROJECT": "REPLACE_WITH_STAGING_PAGES_PROJECT",
      },
      "observability": {
        "enabled": true,
      },
    },
  },
}
