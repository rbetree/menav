// MeNav 形态二动态后台 — 生产 wrangler 配置示例
// 复制为 wrangler.jsonc 后填写自己的 Cloudflare 资源；该文件不要提交。
// 测试环境使用 wrangler.test.example.jsonc，两者职责分开。
{
  "name": "menav-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": { "directory": "../admin", "binding": "ASSETS", "run_worker_first": true },
  // 发布由管理员手动触发；显式空数组用于清除历史定时触发器。
  "triggers": { "crons": [] },
  // 自定义域（可选）。默认留空，Worker 使用 https://<name>.<subdomain>.workers.dev。
  // 绑定到自己的域名时取消注释；custom_domain 由 Cloudflare 自动创建 DNS 与证书。
  // 已有 DNS 记录时改用 { "pattern": "admin.example.com/*", "zone_name": "example.com" }。
  // "routes": [
  //   { "pattern": "admin.example.com", "custom_domain": true },
  // ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "menav-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      // 本地 `wrangler dev` 让 Worker 跑在本地、D1 连远端库(会写真实数据,谨慎使用)。
      "remote": true,
    },
  ],
  "vars": {
    "TEAM_DOMAIN": "https://REPLACE_WITH_TEAM.cloudflareaccess.com",
    "POLICY_AUD": "REPLACE_WITH_ACCESS_AUD",
    "CF_ACCOUNT_ID": "REPLACE_WITH_ACCOUNT_ID",
    "CF_PAGES_PROJECT": "REPLACE_WITH_PAGES_PROJECT",
    // CF_API_TOKEN(Pages 发布) 与 BUILD_TOKEN 用 wrangler secret 设置,不写在此处。
  },
  "observability": {
    "enabled": true,
  },
}
