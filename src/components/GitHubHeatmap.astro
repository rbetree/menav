---
import { prepareHeatmapHtml } from '../lib/github/contributions.ts';
import { buildHeatmapPalette } from '../lib/github/heatmap-colors.ts';

const { heatmap = {} } = Astro.props;
const username = typeof heatmap.username === 'string' ? heatmap.username.trim() : '';

const prepared = prepareHeatmapHtml(heatmap.html);
const visualHtml = prepared.html;

const configuredProfileUrl =
  typeof heatmap.profileUrl === 'string' ? heatmap.profileUrl.trim() : '';
const profileUrl = /^https:\/\/github\.com\/[A-Za-z0-9-]+\/?$/i.test(configuredProfileUrl)
  ? configuredProfileUrl
  : username
    ? `https://github.com/${encodeURIComponent(username)}`
    : '';

const summaryMatch = prepared.summary.match(/([\d,]+)\s+contributions?\s+in\s+the\s+last\s+year/i);
const summarySuffix = profileUrl ? '完整数据见 GitHub 主页。' : '';
const summaryText = summaryMatch
  ? `过去一年共 ${summaryMatch[1].replace(/,/g, '')} 次贡献。${summarySuffix}`
  : `GitHub 贡献热力图。${summarySuffix}`;

// 色阶按主题各自生成：内联样式无法随 html.light-theme 切换，必须用唯一 id 输出两套变量。
const scopeId = `github-heatmap-${username.replace(/[^A-Za-z0-9_-]/g, '-') || 'default'}`;
const palette = buildHeatmapPalette(heatmap.color);
const declarePalette = (values: string[]): string =>
  values.map((value, level) => `--gh-level-${level}: ${value};`).join(' ');
const paletteCss = [
  `#${scopeId} { ${declarePalette(palette.dark)} }`,
  `html.theme-preload #${scopeId}, html.light-theme #${scopeId} { ${declarePalette(palette.light)} }`,
].join('\n');
---

<section class="category category-level-1 gh-heatmap-category" data-type="heatmap" id={scopeId}>
  <style is:inline set:html={paletteCss}></style>

  <div class="category-header">
    <div class="gh-heatmap-header">
      <h2>
        <i class="fab fa-github"></i>
        <span class="gh-text-desktop">GitHub Contributions</span>
        <span class="gh-text-mobile">Contributions</span>
        <span class="gh-heatmap-username">@{username}</span>
      </h2>

      <div class="gh-legend" aria-hidden="true">
        <span>
          <span class="gh-text-desktop">Less</span>
          <span class="gh-text-mobile">L</span>
        </span>
        <div class="gh-legend-item level-0"></div>
        <div class="gh-legend-item level-1"></div>
        <div class="gh-legend-item level-2"></div>
        <div class="gh-legend-item level-3"></div>
        <div class="gh-legend-item level-4"></div>
        <span>
          <span class="gh-text-desktop">More</span>
          <span class="gh-text-mobile">M</span>
        </span>
      </div>
    </div>
  </div>

  <div class="category-content">
    <p class="visually-hidden">{summaryText}</p>
    <div class="gh-heatmap-wrapper">
      {
        visualHtml ? (
          <div
            class="calendar gh-calendar"
            data-github-username={username}
            id={`github-calendar-${username}`}
            aria-hidden="true"
            set:html={visualHtml}
          />
        ) : (
          <p class="gh-heatmap-fallback">贡献热力图暂时不可用。</p>
        )
      }
      {
        profileUrl && (
          <p class="gh-heatmap-link">
            <a href={profileUrl}>在 GitHub 查看完整贡献数据</a>
          </p>
        )
      }
    </div>
  </div>
</section>
