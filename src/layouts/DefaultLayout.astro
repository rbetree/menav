---
import Navigation from '../components/Navigation.astro';
import PageContent from '../components/PageContent.astro';
import RuntimeScripts from '../components/RuntimeScripts.astro';
import SearchBar from '../components/SearchBar.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ThemePreloadScript from '../components/ThemePreloadScript.astro';
import type { NavigationItem, ResolvedConfig } from '../types/config';
import type { PageEntry } from '../types/page';
import type { RenderContext } from '../types/render';
import { getSafeUrl } from '../lib/view-data/view-utils.ts';

interface Props {
  config: ResolvedConfig;
  pages?: PageEntry[];
  navigationData?: NavigationItem[];
  renderContext?: RenderContext;
  fontLinks?: string;
  fontCss?: string;
  currentYear?: number;
  runtimeConfigJson?: string;
  version?: string;
}

const {
  config,
  pages = [],
  navigationData = [],
  renderContext,
  fontLinks = '',
  fontCss = '',
  currentYear,
  runtimeConfigJson = '{}',
  version = '',
} = Astro.props;

const site = config.site || {};
const adminUrl = site.admin_url ? getSafeUrl(site.admin_url, renderContext?.allowedSchemes) : '';
const themeMode = site.theme?.mode || 'dark';
// 本地资源统一 ./<配置相对路径>，与构建复制的 public 路径保持一致；外链不拼前缀。
const toSiteAssetHref = (value: unknown): string => {
  const raw = String(value || '').trim();
  if (!raw) return '';
  if (/^(?:[a-z][a-z0-9+.-]*:|\/\/)/i.test(raw)) return raw;
  return `./${raw.replace(/^\.?\//, '')}`;
};
const favicon = toSiteAssetHref(site.favicon || 'menav.svg');
const brandImage = toSiteAssetHref(site.logo || site.favicon || '');
const fontAwesomeCssUrl =
  'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css';
const fontAwesomePreload = `<link rel="preload" href="${fontAwesomeCssUrl}" as="style" onload="this.onload=null;this.rel='stylesheet'" />`;
---

<!doctype html>
<html lang="zh-CN" data-theme-mode={themeMode} class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
    <meta name="menav-version" content={version} />
    <meta name="theme-color" id="menav-theme-color" content="#0d0c0b" />
    <title data-editable="site-title">{site.title}</title>
    <meta name="description" content={site.description} data-editable="site-description" />
    <meta name="author" content={site.author} data-editable="site-author" />
    {site.keywords && <meta name="keywords" content={site.keywords} />}
    <link rel="icon" href={favicon} type="image/x-icon" />
    <link rel="shortcut icon" href={favicon} type="image/x-icon" />
    <Fragment set:html={fontLinks} />
    <style set:html={fontCss}></style>
    <ThemePreloadScript />
    <link rel="stylesheet" href="./assets/style.css" />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <Fragment set:html={fontAwesomePreload} />
    <noscript>
      <link rel="stylesheet" href={fontAwesomeCssUrl} />
    </noscript>
  </head>
  <body class="loading">
    <a class="skip-link" href="#content">跳到主要内容</a>
    <div class="layout">
      <div class="mobile-buttons">
        <button
          class="menu-toggle"
          aria-label="切换菜单"
          aria-controls="sidebar"
          aria-expanded="false"
        >
          <i class="fas fa-bars"></i>
        </button>
        <button class="search-toggle" aria-label="切换搜索">
          <i class="fas fa-search"></i>
        </button>
      </div>

      <div class="overlay"></div>

      <aside class="sidebar" id="sidebar" aria-label="站点侧栏">
        <header class="logo">
          <div class="logo-brand">
            {
              brandImage && (
                <img class="logo-image" src={brandImage} alt="" width="26" height="26" />
              )
            }
            <span class="logo-text" data-editable="logo-text">{site.logo_text}</span>
          </div>
          <button class="sidebar-toggle" aria-label="收起/展开侧边栏">
            <i class="fas fa-chevron-left toggle-icon"></i>
          </button>
        </header>

        <nav class="sidebar-content" aria-label="页面导航">
          <div class="nav-section">
            <Navigation navigation={navigationData} />
          </div>
          <div
            class="sidebar-submenu-panel"
            role="group"
            aria-label="页面分类"
            data-container="sidebar-submenu"
          >
          </div>
        </nav>

        <div class="sidebar-social" data-container="social-links">
          <SocialLinks
            social={config.social || []}
            allowedSchemes={renderContext?.allowedSchemes}
          />
        </div>

        <footer class="sidebar-footer">
          {site.footer && <p class="site-footer-text">{site.footer}</p>}
          <div class="copyright">
            <p>
              © {currentYear}
              <a href="https://github.com/rbetree/menav" target="_blank" rel="noopener">MeNav</a>
            </p>
            <p>
              by <a href="https://github.com/rbetree" target="_blank" rel="noopener">rbetree</a>
            </p>
          </div>
        </footer>
      </aside>

      <main class="content" id="content" tabindex="-1">
        <SearchBar />

        {
          pages.map((entry) => {
            const pageElement = (
              <div class:list={['page', entry.id, entry.isActive && 'active']} id={entry.id}>
                <PageContent
                  page={entry.data}
                  templateName={entry.templateName}
                  renderContext={renderContext}
                />
              </div>
            );
            // 首页内联脚本与搜索结果容器需要首屏真实 DOM；其余页面由运行时首次切换时克隆
            const isEager =
              Boolean(entry.isActive) ||
              entry.id === 'search-results' ||
              Boolean(entry.data?.isHome);
            return isEager ? (
              pageElement
            ) : (
              <template data-page-template={entry.id}>{pageElement}</template>
            );
          })
        }
      </main>

      {
        adminUrl && adminUrl !== '#' && (
          <a
            class="admin-toggle"
            href={adminUrl}
            target="_blank"
            rel="noopener"
            aria-label="管理后台"
          >
            <svg
              class="admin-toggle-icon"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 7h-9" />
              <path d="M14 17H5" />
              <circle cx="17" cy="17" r="3" />
              <circle cx="7" cy="7" r="3" />
            </svg>
          </a>
        )
      }

      <button class="category-toggle" id="category-toggle" aria-label="展开/收起分类">
        <i class="fas fa-angle-double-down"></i>
      </button>

      <button class="theme-toggle" aria-label="切换主题">
        <i class="fas fa-moon"></i>
      </button>
    </div>

    <RuntimeScripts runtimeConfigJson={runtimeConfigJson} />
  </body>
</html>
