---
import { loadConfig } from '../lib/config/index.ts';

const config = loadConfig();
const title = config?.site?.title || 'MeNav';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} - 页面未找到</title>
    <style>
      :root {
        color-scheme: light;
        --page-bg: #e0e0d8;
        --page-text: #333333;
        --page-muted: #5a5a5a;
        --page-accent: #466387;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          color-scheme: dark;
          --page-bg: #0d0c0b;
          --page-text: #f4f1ea;
          --page-muted: #a49d92;
          --page-accent: #7694b9;
        }
      }

      body {
        margin: 0;
        padding: 40px 16px;
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          Roboto,
          'Helvetica Neue',
          Arial,
          'Noto Sans',
          sans-serif;
        background: var(--page-bg);
        color: var(--page-text);
      }

      .container {
        max-width: 760px;
        margin: 0 auto;
      }

      h1 {
        margin: 0 0 12px;
        font-size: 22px;
      }

      p {
        margin: 8px 0;
        line-height: 1.6;
        color: var(--page-muted);
      }

      a {
        color: var(--page-accent);
        text-decoration: underline;
      }

      a:focus-visible {
        outline: 2px solid var(--page-accent);
        outline-offset: 2px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>页面未找到</h1>
      <p>你访问的页面不存在，或当前静态站点未提供该路径。</p>
      <p><a href="./">返回首页</a></p>
    </div>
  </body>
</html>
